      },
      "content": [
        {
          "type": "text",
          "text": "Submit a short debrief of the term. We want to get a sense of how things went for you. Highlight successes and challenges, talk about your validation steps and success metrics. And finally, discuss some takeaways. Did you achieve what you set out to?",
          "styles": {}
        }
      ],
      "children": []
    },
