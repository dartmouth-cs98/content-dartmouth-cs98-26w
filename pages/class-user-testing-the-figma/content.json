        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "You will have about ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "25 minutes",
          "styles": {
            "bold": true,
            "textColor": "orange"
          }
        },
        {
          "type": "text",
          "text": " of the group's attention",
          "styles": {
            "textColor": "orange"
          }
        },
        {
          "type": "text",
          "text": ". ",
          "styles": {}
        }
      ],
      "children": [
