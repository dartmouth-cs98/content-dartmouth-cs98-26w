          "type": "bulletListItem",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "Briefly describe your product and pose specific questions. ",
              "styles": {
                "bold": true
              }
            }
          ],
          "children": []
        },
        {
          "id": "a87c63de-4432-4fd5-9e03-6d438cae6584",
