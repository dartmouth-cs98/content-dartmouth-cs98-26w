          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "You can organize the time however you like. ",
              "styles": {}
            }
          ],
          "children": [
            {
              "id": "116f7b25-2063-4bff-bf0b-590ec36291c7",
              "type": "bulletListItem",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Maybe you walk through the product for 10 minutes and then open the floor for feedback, Figma comments, and questions. ",
                  "styles": {}
                }
              ],
              "children": []
            },
            {
              "id": "09dd1e5c-b905-4210-9403-3c010fc8978c",
              "type": "bulletListItem",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "Maybe you give your peers the Figma prototype and talk through various tasks they must complete, leaving space for real-time ideas or questions. ",
                  "styles": {}
                }
              ],
              "children": []
            }
          ]
        }
