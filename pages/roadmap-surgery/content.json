      "type": "numberedListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "The 2\u00d72 matrix", "styles": { "bold": true } },
        { "type": "text", "text": " (photo or screenshot)", "styles": {} }
