    {
      "id": "1cfb7625-a385-462f-afb9-60c4e721ae20",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "🚀 Now we are ready to create a new Roadmap View",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "70cf67ba-8914-4251-aa01-a1efbff1b937",
      "type": "image",
      "props": {
        "textAlignment": "left",
