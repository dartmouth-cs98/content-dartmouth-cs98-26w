    {
      "id": "turnin-warning",
      "type": "callout",
      "props": { "emoji": "\u26a0\ufe0f", "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "\"Users liked it\" is not a finding. \"3 of 5 users couldn't find the main action button and 2 gave up after 30 seconds\" \u2014 that's a finding.", "styles": {} }],
      "children": []
    },
