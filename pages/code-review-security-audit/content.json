    {
      "id": "security-intro",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "This is not theoretical. You're running actual checks against your actual deployed product.", "styles": {} }],
      "children": []
    },
    {
      "id": "h3-secrets",
      "type": "heading",
      "props": { "backgroundColor": "default", "textColor": "default", "textAlignment": "left", "level": 3, "isToggleable": false },
      "content": [{ "type": "text", "text": "Secrets Audit", "styles": {} }],
      "children": []
    },
    {
      "id": "secrets-1",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "\ud83d\ude80 Grep your entire repo history for leaked secrets:", "styles": {} }],
      "children": []
    },
    {
      "id": "secrets-code",
      "type": "codeBlock",
      "props": { "language": "bash" },
      "content": [{ "type": "text", "text": "git log --all --full-history -S \"password\" --oneline\ngit log --all --full-history -S \"api_key\" --oneline\ngit log --all --full-history -S \"secret\" --oneline\ngit log --all --full-history -S \"token\" --oneline", "styles": {} }],
      "children": []
    },
    {
      "id": "secrets-2",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "If you find something: rotate the key immediately, add the file to .gitignore, move the secret to environment variables. Document what you found and what you did about it.", "styles": {} }],
      "children": []
    },
    {
      "id": "secrets-warning",
      "type": "callout",
      "props": { "emoji": "\u26a0\ufe0f", "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "Even if you removed a secret in a later commit, it's still in your git history. Anyone who clones the repo can find it. The only fix is rotating the key.", "styles": {} }],
      "children": []
    },
    {
      "id": "spacer-5",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
