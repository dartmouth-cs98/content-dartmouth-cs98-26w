      "type": "heading",
      "props": { "backgroundColor": "blue", "textColor": "default", "textAlignment": "left", "level": 2, "isToggleable": false },
      "content": [{ "type": "text", "text": "Part 1: Deep Code Review", "styles": {} }],
      "children": []
    },
    {
      "id": "cr-intro",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "This is not an \"LGTM\" rubber stamp. This is a real review where you trace through the logic and find real problems.", "styles": {} }],
      "children": []
    },
    {
      "id": "h3-internal",
      "type": "heading",
      "props": { "backgroundColor": "default", "textColor": "default", "textAlignment": "left", "level": 3, "isToggleable": false },
      "content": [{ "type": "text", "text": "Internal Review (one per team member)", "styles": {} }],
      "children": []
    },
    {
      "id": "internal-1",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "\ud83d\ude80 Each person picks the most complex or critical module written by a ", "styles": {} },
        { "type": "text", "text": "different teammate.", "styles": { "bold": true } },
        { "type": "text", "text": " Review it for:", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "internal-b1",
      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Correctness:", "styles": { "bold": true } },
        { "type": "text", "text": " Does this code do what it claims? Trace through the logic.", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "internal-b2",
      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Edge cases:", "styles": { "bold": true } },
        { "type": "text", "text": " Find at least 2 unhandled edge cases. What happens with empty input? Null values? Unexpected types?", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "internal-b3",
      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Readability:", "styles": { "bold": true } },
        { "type": "text", "text": " Could someone new to the project understand this in 10 minutes?", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "internal-b4",
      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Improvements:", "styles": { "bold": true } },
        { "type": "text", "text": " Write at least 3 concrete suggestions with code snippets or pseudocode.", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "internal-2",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "Do this as actual GitHub PR review comments or inline comments on the code. Link to them in your submission.", "styles": {} }],
      "children": []
    },
    {
      "id": "spacer-2",
