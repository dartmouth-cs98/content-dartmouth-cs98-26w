      ],
      "children": []
    },
    {
      "id": "auth-b2",
      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Can someone hit your API without auth?", "styles": { "bold": true } },
        { "type": "text", "text": " Open a terminal and try: ", "styles": {} },
        { "type": "text", "text": "curl https://your-api.com/users", "styles": { "code": true } },
        { "type": "text", "text": " with no token. What happens?", "styles": {} }
      ],
      "children": []
    },
    {
