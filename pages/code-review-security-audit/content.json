    {
      "id": "h2-big-question",
      "type": "heading",
      "props": { "backgroundColor": "blue", "textColor": "default", "textAlignment": "left", "level": 2, "isToggleable": false },
      "content": [{ "type": "text", "text": "Is This Ready for Other Humans?", "styles": {} }],
      "children": []
    },
    {
      "id": "intro-1",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "You've been heads-down building for months. Your roadmap is reprioritized. You're about to launch to real users. But first: is your codebase actually safe and maintainable enough for that?", "styles": {} }],
      "children": []
    },
    {
      "id": "intro-2",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "This milestone has two parts that belong together. Code review asks: can someone else understand and maintain this? Security audit asks: can someone exploit this? Both are versions of the same question \u2014 is this codebase ready for other humans to touch?", "styles": {} }],
      "children": []
    },
    {
      "id": "intro-3",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Most CS programs never make you audit your own code for security. Which means most graduates ship their first production code with secrets in the repo and no input validation. ", "styles": {} },
        { "type": "text", "text": "This is the assignment you'll remember at your first job.", "styles": { "bold": true } }
      ],
      "children": []
    },
    {
      "id": "goal-callout",
      "type": "callout",
      "props": { "emoji": "\ud83c\udfaf", "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "Goal: ", "styles": { "bold": true } },
        { "type": "text", "text": "Deep code review of every team member's work + a real security audit of your deployed product. Merge at least 2 PRs: one refactoring, one security fix.", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "spacer-1",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
