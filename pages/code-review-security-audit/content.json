      "type": "bulletListItem",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "What happens with malformed input?", "styles": { "bold": true } },
        { "type": "text", "text": " Try submitting a form with a script tag, SQL injection string, or a 10MB text blob. Does your app handle it gracefully?", "styles": {} }
