    },
    {
      "id": "cross-1",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [
        { "type": "text", "text": "\ud83d\ude80 One team member reviews a module from ", "styles": {} },
        { "type": "text", "text": "another team's repo.", "styles": { "bold": true } },
        { "type": "text", "text": " Cold. No context. No walkthrough.", "styles": {} }
      ],
      "children": []
    },
    {
      "id": "cross-2",
      "type": "paragraph",
      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "Document: What was easy to understand? What was confusing? What would you change? This perspective is gold \u2014 it simulates what a new hire would experience on day one.", "styles": {} }],
      "children": []
    },
