    {
      "id": "097b46fd-d05a-4569-962b-852c449d1028",
      "type": "paragraph",
      "props": {
        "backgroundColor": "gray",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "NOTE: if your project is based on assets/modeling/robotics/etc., this assignment ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "still applies to you",
          "styles": {
            "textColor": "red"
          }
        },
        {
          "type": "text",
          "text": "! Import images and/or screenshots of what you have currently and draw or annotate on top to indicate what new features you have in mind. ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "There is no such thing as not needing to use Figma.",
          "styles": {
            "bold": true
          }
        }
      ],
      "children": []
    },
    {
      "id": "e7cb0263-7bed-4731-9e80-700a15b019a7",
      "type": "heading",
      "props": {
        "backgroundColor": "yellow",
