      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Every week, after your sprint transition, we’ll do a checkin in class specific to what you what you worked on. You should be prepared to show progress.  We’ll review your transition and help scope out next steps if you need.",
          "styles": {}
        }
      ],
      "children": []
    },
