      "props": { "textColor": "default", "backgroundColor": "default", "textAlignment": "left" },
      "content": [{ "type": "text", "text": "You validated the message. You tested with strangers. You reprioritized the roadmap. You locked down security. Everything before this was preparation.", "styles": {} }],
